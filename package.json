{
  "name": "hallyu-stream",
  "version": "0.1.0",
  "private": true,
  "description": "HALLYU-STREAM — React Native phone + Android TV clients with a Supabase signalling backend",
  "workspaces": [
    "packages/shared",
    "packages/ui",
    "apps/preview"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "preview": "npm run dev --workspace @hallyu/preview",
    "build:preview": "npm run build --workspace @hallyu/preview",
    "start:mobile": "npm run start --prefix apps/mobile",
    "start:tv": "npm run start --prefix apps/tv"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.5",
    "react-native-web": "^0.19.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
