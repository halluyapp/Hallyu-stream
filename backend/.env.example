# HALLYU-STREAM pairing service — environment
PORT=8787
HOST=0.0.0.0

# Durable SQLite database (WAL). Use a mounted volume in production.
DATABASE_PATH=./data/pairing.db

# Pairing challenge lifetime in seconds (5-15 minutes per architecture pack 07).
PAIRING_TTL_SECONDS=600

# REQUIRED in production. Generate with: openssl rand -base64 48
TOKEN_PEPPER=replace-with-a-long-random-value

# Comma separated browser origins allowed to call the API. Empty = allow all (dev only).
ALLOWED_ORIGINS=

# Set to 1 when running behind a trusted reverse proxy (rate limiting uses client IP).
TRUST_PROXY=0

# Housekeeping interval for expired sessions.
CLEANUP_INTERVAL_SECONDS=60

NODE_ENV=development
