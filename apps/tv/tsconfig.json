{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@hallyu/shared": ["../../packages/shared/src"],
      "@hallyu/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["src/**/*", "index.js"]
}
