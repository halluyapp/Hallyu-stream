<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner: 320x180dp, obsidian with a copper rule. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <size android:width="320dp" android:height="180dp" />
      <solid android:color="#0A0B0D" />
    </shape>
  </item>
  <item android:left="48dp" android:right="48dp" android:top="132dp" android:bottom="44dp">
    <shape android:shape="rectangle">
      <solid android:color="#C97B4A" />
    </shape>
  </item>
</layer-list>
