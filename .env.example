# ─────────────────────────────────────────────────────────────
# Client (safe to ship in the app binary — not a secret)
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
EXPO_PUBLIC_PAIRING_CLIENT_KEY=<same-value-as-PAIRING_CLIENT_KEY>

# Optional: override the documented provider base (dev only)
# EXPO_PUBLIC_ZAR_BASE_URL=https://movieapi.zarhosting.dpdns.org/api/public/v1

# ─────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (server-side only — NEVER ship)
# Set with: supabase secrets set --project-ref <ref> PAIRING_CODE_SECRET=... PAIRING_CLIENT_KEY=...
# ─────────────────────────────────────────────────────────────
PAIRING_CODE_SECRET=<32-byte-random-hex>
PAIRING_CLIENT_KEY=<32-byte-random-hex>

# ─────────────────────────────────────────────────────────────
# Local convenience (never committed)
# ─────────────────────────────────────────────────────────────
# SUPABASE_DB_PASSWORD=<generated-at-project-creation>
